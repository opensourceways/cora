                  "packagename": {
                    "type": "string"
                  },
                  "source_build_method": {
                    "type": "string"
                  },
                  "max_builds": {
                    "type": "integer"
                  },
                  "webhook_rebuild": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "required": true
        }
      }
    },
