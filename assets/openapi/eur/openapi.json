{
  "openapi": "3.0.2",
  "info": {
    "title": "Copr API",
    "version": "v3",
    "description": "See python client - <https://python-copr.readthedocs.io>"
  },
  "servers": [
    {
      "url": "/api_3"
    }
  ],
  "paths": {
    "/build/{build_id}": {
      "get": {
        "operationId": "get_get_build",
        "summary": "Get a build",
        "tags": [
          "build"
        ],
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "required": true,
            "description": "Numeric ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Build"
                }
              }
            }
          }
        }
      }
    },
    "/package/": {
      "get": {
        "operationId": "get_get_package",
        "summary": "Get a package",
        "tags": [
          "package"
        ],
        "parameters": [
          {
            "name": "ownername",
            "in": "query",
            "required": true,
            "description": "User or group name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectname",
            "in": "query",
            "required": true,
            "description": "Name of the project",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "packagename",
            "in": "query",
            "required": true,
            "description": "Name of the package",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "with_latest_build",
            "in": "query",
            "required": false,
            "description": "The result will contain 'builds' dictionary with the latest submitted build of this particular package within the project",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "with_latest_succeeded_build",
            "in": "query",
            "required": false,
            "description": "The result will contain 'builds' dictionary with the latest successful build of this particular package within the project.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Package"
                }
              }
            }
          }
        }
      }
    },
    "/package/add/{ownername}/{projectname}/{package_name}/{source_type_text}": {
      "post": {
        "operationId": "post_package_add",
        "summary": "Create a package",
        "tags": [
          "package"
        ],
        "parameters": [
          {
            "name": "ownername",
            "in": "path",
            "required": true,
            "description": "User or group name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectname",
            "in": "path",
            "required": true,
            "description": "Name of the project",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "package_name",
            "in": "path",
            "required": true,
            "description": "Name of the package",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source_type_text",
            "in": "path",
            "required": true,
            "description": "See https://python-copr.readthedocs.io/en/latest/client_v3/package_source_types.html",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Package"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "clone_url": {
                    "type": "string"
                  },
                  "committish": {
                    "type": "string"
                  },
                  "subdirectory": {
                    "type": "string"
                  },
                  "spec": {
                    "type": "string"
                  },
                  "scm_type": {
                    "type": "string"
                  },
                  "gem_name": {
                    "type": "string"
                  },
                  "pypi_package_name": {
                    "type": "string"
                  },
                  "pypi_package_version": {
                    "type": "string"
                  },
                  "spec_generator": {
                    "type": "string"
                  },
                  "spec_template": {
                    "type": "string"
                  },
                  "python_versions": {
                    "type": "string"
                  },
                  "script": {
                    "type": "string"
                  },
                  "builddeps": {
                    "type": "string"
                  },
                  "resultdir": {
                    "type": "string"
                  },
                  "chroot": {
                    "type": "string"
                  },
                  "packagename": {
                    "type": "string"
                  },
                  "source_build_method": {
                    "type": "string"
                  },
                  "max_builds": {
                    "type": "integer"
                  },
                  "webhook_rebuild": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
