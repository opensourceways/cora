            "name": "source_type_text",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "See https://python-copr.readthedocs.io/en/latest/client_v3/package_source_types.html"
          }
        ],
        "tags": [
          "package"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "clone_url": {
                    "type": "string"
                  },
                  "committish": {
                    "type": "string"
                  },
                  "subdirectory": {
                    "type": "string"
                  },
                  "spec": {
                    "type": "string"
                  },
                  "scm_type": {
                    "type": "string"
                  },
                  "gem_name": {
                    "type": "string"
                  },
                  "pypi_package_name": {
                    "type": "string"
                  },
                  "pypi_package_version": {
                    "type": "string"
                  },
                  "spec_generator": {
                    "type": "string"
                  },
                  "spec_template": {
                    "type": "string"
                  },
                  "python_versions": {
                    "type": "string"
                  },
                  "script": {
                    "type": "string"
                  },
                  "builddeps": {
                    "type": "string"
                  },
                  "resultdir": {
                    "type": "string"
