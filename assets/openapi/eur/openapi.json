  "paths": {
    "/build/{build_id}": {
      "get": {
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Build"
            }
          }
        },
        "summary": "Get a build",
        "description": "Get details for a single Copr build.",
        "operationId": "get_get_build",
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Numeric ID"
          }
        ],
        "tags": [
          "build"
        ]
      }
    },
    "/package/": {
      "get": {
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Package"
            }
          }
        },
        "summary": "Get a package",
        "description": "Get a single package from a Copr project.",
        "operationId": "get_get_package",
        "parameters": [
          {
            "name": "ownername",
            "in": "query",
            "type": "string",
            "required": true,
            "description": "User or group name"
          },
          {
            "name": "projectname",
            "in": "query",
            "type": "string",
            "required": true,
            "description": "Name of the project"
          },
          {
            "name": "packagename",
            "in": "query",
            "type": "string",
            "required": true,
            "description": "Name of the package"
          },
          {
            "name": "with_latest_build",
            "in": "query",
            "type": "boolean",
            "description": "The result will contain 'builds' dictionary with the latest submitted build of this particular package within the project",
            "default": false
          },
          {
            "name": "with_latest_succeeded_build",
            "in": "query",
            "type": "boolean",
            "description": "The result will contain 'builds' dictionary with the latest successful build of this particular package within the project.",
            "default": false
          }
        ],
        "tags": [
          "package"
        ]
      }
    },
    "/package/add/{ownername}/{projectname}/{package_name}/{source_type_text}": {
      "post": {
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Package"
