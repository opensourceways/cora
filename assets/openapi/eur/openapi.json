    "/project-chroot/": {
      "get": {
        "operationId": "get_project_chroot",
        "summary": "Get a project chroot",
        "tags": [
          "project-chroot"
        ],
        "parameters": [
          {
            "name": "ownername",
            "in": "query",
            "required": true,
            "description": "User or group name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectname",
            "in": "query",
            "required": true,
            "description": "Name of the project",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "chrootname",
            "in": "query",
            "required": true,
            "description": "Mock chroot",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectChroot"
                }
              }
            }
          }
        }
      }
    },
    "/project-chroot/build-config": {
      "get": {
        "operationId": "get_build_config",
        "summary": "Get a build config",
        "tags": [
          "project-chroot"
        ],
        "parameters": [
          {
            "name": "ownername",
            "in": "query",
            "required": true,
            "description": "User or group name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectname",
            "in": "query",
            "required": true,
            "description": "Name of the project",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "chrootname",
            "in": "query",
            "required": true,
            "description": "Mock chroot",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectChrootBuildConfig"
                }
              }
            }
          }
